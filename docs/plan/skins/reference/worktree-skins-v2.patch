+  for (let i = 0; i < pos.count; i++) {
+    const y = pos.getY(i)
+    const mix = THREE.MathUtils.smoothstep(y, -0.65, 0.45)
+    const c = topColor.clone().lerp(CREAM, 1 - mix)
+    colors[i * 3] = c.r
+    colors[i * 3 + 1] = c.g
+    colors[i * 3 + 2] = c.b
+  }
+  geo.setAttribute('color', new THREE.BufferAttribute(colors, 3))
+  return geo
