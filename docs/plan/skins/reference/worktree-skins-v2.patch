+        api.place(g, EYE.phi, s > 0 ? EYE.th : Math.PI - EYE.th, -0.026)
+      }
+      const p = new THREE.Vector3(), n = new THREE.Vector3()
+      api.surf(api.zAt(1.0), -0.12, p, n)
