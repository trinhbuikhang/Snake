+      if (blinkT < -0.13) blinkT = 2.8 + ((animT * 7.13) % 2)
+      state.animT = animT; state.dt = dt; state.isBoosting = isBoosting; state.death = death
+      state.blink = death ? 0.15 : blinkT < 0 && !globalThis.__serpentNoBlink ? 0.1 : 1
+      cfg.update?.(state)
+    },
+  }
+  return rig
+}
