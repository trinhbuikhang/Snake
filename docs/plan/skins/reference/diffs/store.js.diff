+// Serpent skins: owned + selected, validated against the registry.
+export const readSkins = () => {
+  const fresh = { owned: SKIN_IDS.filter((id) => canUnlockSkin(skinById(id), null)), selected: DEFAULT_SKIN }
+  try {
+    const parsed = JSON.parse(readItem(SKIN_KEY) || 'null')
+    if (parsed && typeof parsed === 'object') {
+      if (Array.isArray(parsed.owned)) fresh.owned = [...new Set([...fresh.owned, ...parsed.owned.filter((id) => SKIN_IDS.includes(id))])]
+      if (fresh.owned.includes(parsed.selected)) fresh.selected = parsed.selected
+    }
+  } catch {
+    /* corrupt entry: fall back to defaults */
+  }
+  return fresh
+}
